# Conecta no MESMO projeto Supabase do app TikTally (zgkxtyewmbkupuzeoyya).
# O backoffice usa apenas a chave pública (anon) — toda operação privilegiada
# passa pela edge function bo-fiscal, que valida profiles.is_admin server-side.
VITE_SUPABASE_URL="https://api.tiktally.com.br"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-key-do-projeto>"

# Nomes das edge functions gateway (defaults abaixo). Só altere se renomear.
VITE_BO_FISCAL_FN="bo-fiscal"
VITE_BO_COUPONS_FN="bo-coupons"

# Teste LOCAL (sem deploy): aponte o front pras functions rodando via
# `supabase functions serve`. Em produção, deixe COMENTADO.
# VITE_BO_FISCAL_URL="http://localhost:54321/functions/v1/bo-fiscal"
# VITE_BO_COUPONS_URL="http://localhost:54321/functions/v1/bo-coupons"

# Modo PREVIEW (DEV ONLY): pula o login (admin fake) e serve dados mock em todas
# as telas — pra visualizar o backoffice sem auth nem backend. NUNCA em produção.
# VITE_DEV_PREVIEW="true"
