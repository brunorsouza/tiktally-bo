# Env para rodar a edge function bo-fiscal LOCALMENTE apontando pro projeto REAL.
#   supabase functions serve bo-fiscal --no-verify-jwt --env-file supabase/functions/.env.local
# Copie para .env.local e preencha. NÃO commitar (.env.local é gitignored).
#
# Use a URL canônica do projeto (não o domínio custom) pra o getUser() validar o JWT:
SUPABASE_URL="https://zgkxtyewmbkupuzeoyya.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key-do-projeto>"

# Spedy — os MESMOS secrets que as outras functions já usam em produção:
SPEDY_API_KEY="<owner-api-key-spedy>"
SPEDY_API_BASE_URL="https://api.spedy.com.br/v1/"
SPEDY_SANDBOX_API_KEY="<sandbox-api-key-spedy>"
SPEDY_SANDBOX_API_URL="https://sandbox-api.spedy.com.br/v1/"
